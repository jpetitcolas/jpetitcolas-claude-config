{
    "version": "1.0",
    "description": "Skill activation triggers for Claude Code. Controls when skills automatically suggest or block actions.",
    "skills": {
        "skill-developer": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Meta-skill for creating and managing Claude Code skills",
            "promptTriggers": {
                "keywords": [
                    "skill system",
                    "create skill",
                    "add skill",
                    "skill triggers",
                    "skill rules",
                    "hook system",
                    "skill development",
                    "skill-rules.json"
                ],
                "intentPatterns": [
                    "(how do|how does|explain).*?skill",
                    "(create|add|modify|build).*?skill",
                    "skill.*?(work|trigger|activate|system)"
                ]
            }
        },
        "semantic-commits": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "medium",
            "description": "Guidance for creating semantic commit messages following conventional commit standards",
            "promptTriggers": {
                "keywords": [
                    "commit",
                    "commit message",
                    "git commit"
                ],
                "intentPatterns": [
                    "(create|write|make|add).*?commit",
                    "commit.*?(message|convention|standard|format)",
                    "(how to|best practice).*?commit",
                    "^commit",
                    "(let's|lets).*?commit",
                    "(ready|going|about).*?commit",
                    "commit.*(change|code|file|this|it|everything)",
                    "commit.*?(and|then).*?push"
                ]
            }
        }
    },
    "notes": {
        "enforcement_types": {
            "suggest": "Skill suggestion appears but doesn't block execution",
            "block": "Requires skill to be used before proceeding (guardrail)",
            "warn": "Shows warning but allows proceeding"
        },
        "priority_levels": {
            "critical": "Highest - Always trigger when matched",
            "high": "Important - Trigger for most matches",
            "medium": "Moderate - Trigger for clear matches",
            "low": "Optional - Trigger only for explicit matches"
        },
        "customization": {
            "pathPatterns": "Generic patterns work across all project structures. Customize via plugin fork if needed.",
            "keywords": "Add domain-specific terms relevant to your project",
            "intentPatterns": "Use regex for flexible user intent matching"
        }
    }
}
